FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY ["Restfill.API.csproj", "./"]

RUN dotnet restore "Restfill.API.csproj"

COPY . .

RUN dotnet publish "Restfill.API.csproj" -c Release -o /app/publish /p:UseAppHost=false


FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Restfill.API.dll"]